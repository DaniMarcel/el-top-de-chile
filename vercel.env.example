# ============ TOP DE CHILE — variables para Vercel ============
# Pega esto en Vercel → Project → Settings → Environment Variables
# (Production, y también Preview/Development si quieres)

# URL de Neon (Connection string con sslmode=require)
DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# URL pública del sitio
SITE_URL=https://topdechile.cl

# Token del admin (CÁMBIALO — ej: openssl rand -hex 16)
ADMIN_TOKEN=topdechile-admin-2026

# Pagos: true hasta conectar Flow.cl
MOCK_PAYMENTS=true
