# ============ EL TRONO — configuración ============

# URL pública del sitio (cambia en producción)
SITE_URL=http://localhost:3000

# --- Pagos (Flow.cl) ---
# Modo demo: pagos simulados. Con esto NO necesitas cuenta Flow para probar.
MOCK_PAYMENTS=true
# Para activar pagos reales: MOCK_PAYMENTS=false y completa estas 3 llaves
# (panel de Flow.cl → Integración API → credenciales del comercio)
FLOW_API_KEY=
FLOW_SECRET=
FLOW_COMMERCE_EMAIL=

# --- Reglas del juego ---
# Precio base del trono en una categoría vacía (CLP, ~1 USD)
STARTING_PRICE=1000
# Incremento mínimo para destronar (CLP)
MIN_INCREMENT=500

# --- Admin ---
# Token para entrar a /admin (cámbialo en producción)
ADMIN_TOKEN=eltrono-admin

# --- Base de datos ---
# En dev: SQLite local automático (data/trono.db).
# En producción (Vercel): pega acá la DATABASE_URL de Supabase
# (Dashboard → Project Settings → Database → Connection string → URI)
# DATABASE_URL=postgresql://postgres.XXXX:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
