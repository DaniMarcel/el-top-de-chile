# ============ EL TRONO — producción ============

# URL pública del sitio (tu dominio real)
SITE_URL=https://topdechile.cl

# --- Pagos (Flow.cl) ---
# En producción: pagos reales. Completa tus credenciales del comercio
# (panel de Flow.cl → Integración API) y pon MOCK_PAYMENTS=false.
MOCK_PAYMENTS=false
FLOW_API_KEY=
FLOW_SECRET=
FLOW_COMMERCE_EMAIL=

# --- Reglas del juego ---
STARTING_PRICE=1000
MIN_INCREMENT=500

# --- Admin ---
# CAMBIA ESTO por un token seguro (ej: openssl rand -hex 16)
ADMIN_TOKEN=cambia-este-token

# --- Base de datos ---
# Ruta donde se guarda la DB (en Docker usa el volumen montado)
DB_PATH=/data/trono.db
